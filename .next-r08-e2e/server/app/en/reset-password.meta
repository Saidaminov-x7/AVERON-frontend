{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(auth)/layout,_N_T_/[locale]/(auth)/reset-password/layout,_N_T_/[locale]/(auth)/reset-password/page,_N_T_/en/reset-password"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/!KGF1dGgp/reset-password/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 96,
                "slots": {
                  "children": {
                    "hints": 160,
                    "slots": null
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}